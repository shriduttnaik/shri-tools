      ],
      "webhookId": "7b1c0e10-2a3d-4e5f-9a00-000000000040"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7b1c0e10-2a3d-4e5f-9a00-000000000051",
              "name": "base_url",
              "value": "http://127.0.0.1:7880",
              "type": "string"
            },
            {
              "id": "7b1c0e10-2a3d-4e5f-9a00-000000000052",
              "name": "api_key",
              "value": "PUT-YOUR-API-KEY-HERE-OR-LEAVE-EMPTY",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "7b1c0e10-2a3d-4e5f-9a00-000000000005",
      "name": "Shri Tools settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        180,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fields come from 'Your video' (manual) or from the webhook body\nconst keys = ['title', 'idea', 'prompt', 'scenes', 'season', 'season_id', 'language', 'style', 'cast',\n  'scenes_wanted', 'approve_pictures', 'music', 'hook_text', 'callback_url'];\nreturn $input.all().map((item) => {\n  const src = item.json.body ?? item.json;\n  const payload = {};\n  for (const k of keys) if (src[k] !== undefined && src[k] !== '') payload[k] = src[k];\n  if (!payload.idea && !payload.prompt && !payload.scenes) throw new Error('Send an idea or scenes');\n  const key = item.json.api_key === 'PUT-YOUR-API-KEY-HERE-OR-LEAVE-EMPTY' ? '' : (item.json.api_key || '');\n  return { json: { payload, base_url: item.json.base_url, api_key: key } };\n});"
      },
      "id": "7b1c0e10-2a3d-4e5f-9a00-000000000006",
      "name": "Make request body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url }}/api/connect/videos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $json.api_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {}
      },
      "id": "7b1c0e10-2a3d-4e5f-9a00-000000000007",
      "name": "Start video",
