            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "7b1c0e10-2a3d-4e5f-9a00-000000000101",
              "leftValue": "={{ $json.video.state }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7b1c0e10-2a3d-4e5f-9a00-000000000010",
      "name": "Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1280,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "7b1c0e10-2a3d-4e5f-9a00-000000000111",
              "leftValue": "={{ ['failed', 'cancelled'].includes($json.video.state) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7b1c0e10-2a3d-4e5f-9a00-000000000011",
      "name": "Failed?",
